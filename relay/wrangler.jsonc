{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "droptables-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // APP_ID, APP_INSTALLATION_ID and TURNSTILE_SITEKEY come from the deploy workflow,
  // APP_KEY and TURNSTILE_SECRET are Worker secrets (see SETUP.md).
  "vars": {
    "REPO_OWNER": "valcheffnet",
    "REPO_NAME": "DropTables"
  },
  "ratelimits": [
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
